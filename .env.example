# ==========================================
# LIVUS E-Commerce Application Environment Variables
# Copy to .env.local for local development. Never commit real values.
# Full guide (where to get each value): docs/DEPLOYMENT.md
# REQUIRED in production = the app refuses to start without it (src/lib/env.ts).
# ==========================================

# ------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------
# REQUIRED. Neon → Project → Connection string (pooled), must end with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# Authentication (Better Auth & Admin Session)
# ------------------------------------------
# REQUIRED. Random secret, at least 32 characters (openssl rand -base64 32). Also signs the admin session cookie.
BETTER_AUTH_SECRET="generate-a-strong-32-byte-secret-key-here"
# REQUIRED (this or NEXT_PUBLIC_APP_URL). Public site address; must be https:// on Vercel Production.
BETTER_AUTH_URL="http://localhost:3000"
# Optional. Legacy fallback for signing admin sessions, only used if BETTER_AUTH_SECRET is not set.
ADMIN_SESSION_SECRET="generate-a-strong-admin-jwt-secret-key-here"

# ------------------------------------------
# Storefront & Canonical URLs
# ------------------------------------------
# REQUIRED (this or BETTER_AUTH_URL). Used in emails, sitemap, robots, share links; https:// on Vercel Production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# Transactional Email (Brevo / Sendinblue SMTP & API)
# Recommended. Without the API key or SMTP user+key, no emails are sent.
# ------------------------------------------
# Brevo → SMTP & API → API Keys (preferred delivery method)
BREVO_API_KEY="xkeysib-your-brevo-api-key"
# Brevo → SMTP & API → SMTP key (fallback if the API call fails)
BREVO_SMTP_KEY="xsmtpsib-your-smtp-relay-key"
# Brevo → SMTP & API → SMTP login
BREVO_SMTP_USER="your-login@smtp-brevo.com"
# Optional. Defaults to smtp-relay.brevo.com
BREVO_SMTP_HOST="smtp-relay.brevo.com"
# Optional. Defaults to 587
BREVO_SMTP_PORT="587"
# Display name on outgoing emails
BREVO_SENDER_NAME="LIVUS"
# Sender address on your Brevo-verified domain
BREVO_SENDER_EMAIL="orders@yourdomain.com"

# ------------------------------------------
# Social OAuth Providers (optional; set both of a pair or neither)
# ------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# Secret of the same Google OAuth client
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# Meta for Developers → your app → App settings → Basic → App ID
FACEBOOK_CLIENT_ID="your-facebook-app-id"
# Same page → App secret
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
# Optional Sign in with Apple — Apple Developer → Services ID
APPLE_CLIENT_ID="com.example.store.client"
# Optional Sign in with Apple — generated client secret (JWT)
APPLE_CLIENT_SECRET="your-apple-auth-key-or-secret"

# ------------------------------------------
# File Storage (Vercel Blob)
# ------------------------------------------
# Recommended. Added automatically when you connect a Vercel Blob store; needed for admin image uploads on Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_read_write_token"

# Not currently read by the app (reserved for a future S3/R2 fallback). Leave unset.
# S3_BUCKET="my-store-assets"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"
# S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ------------------------------------------
# Analytics & Marketing Tracking (optional, recommended before ads)
# ------------------------------------------
# Meta Events Manager → Data sources → your Pixel → Pixel ID (digits only)
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
# Google Analytics → Admin → Data streams → Measurement ID
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ------------------------------------------
# Pricing & VAT Overrides (optional fallbacks)
# ------------------------------------------
# VAT percentage fallback. Defaults to 10
VAT_PERCENT="10"
# Flat delivery charge fallback in BDT. Defaults to 150
DELIVERY_CHARGE_BDT="150"

# ------------------------------------------
# Set automatically by Vercel / Next.js / CI — do NOT set these yourself
# ------------------------------------------
# NODE_ENV, NEXT_RUNTIME, NEXT_PHASE, CI,
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_BRANCH_URL, VERCEL_PROJECT_PRODUCTION_URL
