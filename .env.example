# ==========================================
# LIVUS E-Commerce Application Environment Variables
# ==========================================

# ------------------------------------------
# Database Configuration (Neon Serverless PostgreSQL)
# ------------------------------------------
DATABASE_URL="postgresql://neondb_owner:npg_password@ep-silent-hill-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# Authentication (Better Auth & Admin Session)
# ------------------------------------------
BETTER_AUTH_SECRET="generate-a-strong-32-byte-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_SESSION_SECRET="generate-a-strong-admin-jwt-secret-key-here"

# ------------------------------------------
# Storefront & Canonical URLs
# ------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# Transactional Email (Brevo / Sendinblue SMTP & API)
# ------------------------------------------
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SMTP_KEY="xsmtpsib-your-smtp-relay-key"
BREVO_SMTP_USER="smtp-login@smtp-relay.brevo.com"
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SENDER_NAME="LIVUS Atelier"
BREVO_SENDER_EMAIL="orders@livus.com.bd"

# ------------------------------------------
# Social OAuth Providers
# ------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
FACEBOOK_CLIENT_ID="your-facebook-app-id"
FACEBOOK_CLIENT_SECRET="your-facebook-app-secret"
APPLE_CLIENT_ID="com.livus.store.client"
APPLE_CLIENT_SECRET="your-apple-auth-key-or-secret"

# ------------------------------------------
# File Storage (Vercel Blob / S3-compatible)
# ------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_read_write_token"

# Optional S3 Fallback
S3_BUCKET="my-store-assets"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"

# ------------------------------------------
# Analytics & Marketing Tracking
# ------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID="123456789012345"
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ------------------------------------------
# Pricing & VAT Overrides (Defaults configured in Admin Settings)
# ------------------------------------------
VAT_PERCENT="10"
DELIVERY_CHARGE_BDT="150"
